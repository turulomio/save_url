msgid "Unsupported backend '{}'"
msgstr "Backend-ul '{}' nu este suportat"

msgid "Executable '{}' wasn't found in your system path"
msgstr "Fișierul executabil '{}' nu a fost găsit în calea de sistem (PATH)"

msgid "Please install {} from {}"
msgstr "Vă rugăm să instalați {} de la {}"

msgid "No Chromium-based browser found for single-file. Using 'monolith' backend instead."
msgstr "Nu a fost găsit niciun browser bazat pe Chromium pentru single-file. Se utilizează backend-ul 'monolith' în schimb."

msgid "No Chromium-based browser (chromium, google-chrome, brave) was found in your system path."
msgstr "Nu a fost găsit niciun browser bazat pe Chromium (chromium, google-chrome, brave) în calea de sistem (PATH)."

msgid "single-file-cli requires Chromium. Please install a Chromium browser or install monolith."
msgstr "single-file-cli necesită Chromium. Vă rugăm să instalați un browser Chromium sau să instalați monolith."

msgid "Title was found searching in <title> tag"
msgstr "Titlul a fost găsit căutând în eticheta <title>"

msgid "Title was found with mechanize"
msgstr "Titlul a fost găsit cu mechanize"

#, python-brace-format
msgid "Error getting page title with mechanize: {0}"
msgstr "Eroare la obținerea titlului paginii cu mechanize: {0}"

msgid "If you like this app, please give me a star in https://github.com/turulomio/save_url."
msgstr "Dacă vă place această aplicație, vă rugăm să lăsați o stea pe https://github.com/turulomio/save_url."

msgid "Developed by Mariano Muñoz 2019-{} ©"
msgstr "Dezvoltat de Mariano Muñoz 2019-{} ©"

msgid "Url to save"
msgstr "URL de salvat"

msgid "Removes date and time from the beginning of the file name"
msgstr "Elimină data și ora de la începutul numelui fișierului"

msgid "Script to save an url in a single file with an automatic and structured name. It uses monolith as its backend."
msgstr "Script pentru salvarea unui URL într-un singur fișier cu un nume automat și structurat. Utilizează monolith ca backend."

msgid "Script to save an url in a single file with an automatic and structured name using single-file backend."
msgstr "Script pentru salvarea unui URL într-un singur fișier cu un nume automat și structurat utilizând backend-ul single-file."

msgid "Script to save an url in a single file with an automatic and structured name using monolith backend."
msgstr "Script pentru salvarea unui URL într-un singur fișier cu un nume automat și structurat utilizând backend-ul monolith."

msgid "I couldn't extract web page title. Please write it"
msgstr "Nu s-a putut extrage titlul paginii web. Vă rugăm să îl introduceți"

msgid "Something is wrong with saved file. Please Checkit"
msgstr "Ceva nu este în regulă cu fișierul salvat. Vă rugăm să verificați"

msgid "File '{}' ({}) saved correctly."
msgstr "Fișierul '{}' ({}) a fost salvat cu succes."

