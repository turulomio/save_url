msgid "Monolith executable wasn't found in your system path"
msgstr "Исполняемый файл Monolith не найден в системном пути PATH"

msgid "Monolith is a CLI tool for saving complete web pages as a single HTML file that you can find in https://github.com/Y2Z/monolith"
msgstr "Monolith — это CLI-утилита для сохранения полных веб-страниц в виде одного HTML-файла, доступная по адресу https://github.com/Y2Z/monolith"

msgid "Title was found with mechanize"
msgstr "Заголовок был найден с помощью mechanize"

#, python-brace-format
msgid "Error getting page title with mechanize: {0}"
msgstr "Ошибка при получении заголовка страницы с помощью mechanize: {0}"

msgid "Title was found searching in <title> tag"
msgstr "Заголовок был найден в теге <title>"

msgid "Error getting page title searching in <title> tag"
msgstr "Ошибка при получении заголовка страницы из тега <title>"

msgid "Script to save and url in a single file with an automatic and structured name. It uses monolith as its backend."
msgstr "Скрипт для сохранения URL в один файл с автоматическим и структурированным именем. Использует monolith в качестве бэкенда."

msgid "If you like this app, please give me a star in https://github.com/turulomio/save_url."
msgstr "Если вам нравится это приложение, пожалуйста, поставьте звезду на https://github.com/turulomio/save_url."

msgid "Developed by Mariano Muñoz 2019-{} ©"
msgstr "Разработано Mariano Muñoz 2019-{} ©"

msgid "Url to save"
msgstr "URL для сохранения"

msgid "Removes date and time from the beginning of the file name"
msgstr "Удаляет дату и время из начала имени файла"

msgid "I couldn't extract web page title. Please write it"
msgstr "Не удалось извлечь заголовок веб-страницы. Пожалуйста, введите его"

msgid "Something is wrong with saved file. Please Checkit"
msgstr "Что-то не так с сохраненным файлом. Пожалуйста, проверьте его"

msgid "File '{}' ({}) saved correctly."
msgstr "Файл '{}' ({}) успешно сохранен."
