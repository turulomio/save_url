msgid "Unsupported backend '{}'"
msgstr "Неподдерживаемый бэкенд '{}'"

msgid "Executable '{}' wasn't found in your system path"
msgstr "Исполняемый файл '{}' не найден в системном пути PATH"

msgid "Please install {} from {}"
msgstr "Пожалуйста, установите {} с {}"

msgid "No Chromium-based browser found for single-file. Using 'monolith' backend instead."
msgstr "Не найден браузер на базе Chromium для single-file. Вместо этого используется бэкенд 'monolith'."

msgid "No Chromium-based browser (chromium, google-chrome, brave) was found in your system path."
msgstr "В вашем системном пути PATH не найден браузер на базе Chromium (chromium, google-chrome, brave)."

msgid "single-file-cli requires Chromium. Please install a Chromium browser or install monolith."
msgstr "single-file-cli требует Chromium. Пожалуйста, установите браузер Chromium или установите monolith."

msgid "Title was found searching in <title> tag"
msgstr "Заголовок был найден в теге <title>"

msgid "Title was found with mechanize"
msgstr "Заголовок был найден с помощью mechanize"

#, python-brace-format
msgid "Error getting page title with mechanize: {0}"
msgstr "Ошибка при получении заголовка страницы с помощью mechanize: {0}"

msgid "If you like this app, please give me a star in https://github.com/turulomio/save_url."
msgstr "Если вам нравится это приложение, пожалуйста, поставьте звезду на https://github.com/turulomio/save_url."

msgid "Developed by Mariano Muñoz 2019-{} ©"
msgstr "Разработано Mariano Muñoz 2019-{} ©"

msgid "Url to save"
msgstr "URL для сохранения"

msgid "Removes date and time from the beginning of the file name"
msgstr "Удаляет дату и время из начала имени файла"

msgid "Script to save an url in a single file with an automatic and structured name. It uses monolith as its backend."
msgstr "Скрипт для сохранения URL в один файл с автоматическим и структурированным именем. Использует monolith в качестве бэкенда."

msgid "Script to save an url in a single file with an automatic and structured name using single-file backend."
msgstr "Скрипт для сохранения URL в один файл с автоматическим и структурированным именем с использованием бэкенда single-file."

msgid "Script to save an url in a single file with an automatic and structured name using monolith backend."
msgstr "Скрипт для сохранения URL в один файл с автоматическим и структурированным именем с использованием бэкенда monolith."

msgid "I couldn't extract web page title. Please write it"
msgstr "Не удалось извлечь заголовок веб-страницы. Пожалуйста, введите его"

msgid "Something is wrong with saved file. Please Checkit"
msgstr "Что-то не так с сохраненным файлом. Пожалуйста, проверьте его"

msgid "File '{}' ({}) saved correctly."
msgstr "Файл '{}' ({}) успешно сохранен."

#~ msgid "Error getting page title searching in <title> tag"
#~ msgstr "Ошибка при получении заголовка страницы из тега <title>"

#~ msgid "Script to save an url in a single file with an automatic and structured name."
#~ msgstr "Скрипт для сохранения URL в один файл с автоматическим и структурированным именем."

